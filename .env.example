# Discord
DISCORD_BOT_TOKEN=
ALLOWED_GUILD_IDS=              # comma-separated guild IDs (deny-all if empty)
DISCORD_CHANNEL_IDS=            # comma-separated allowed channel IDs (global)
FIRST_CHANNEL_IDS=              # comma-separated channel IDs for .first
CHECK_CHANNEL_IDS=              # comma-separated channel IDs for .cek

# Twitter/X cookies (single pair or multiple comma-separated)
X_AUTH_TOKEN=
X_CT0=
X_AUTH_TOKENS=                  # comma-separated for pool rotation
X_CT0S=                        # comma-separated for pool rotation

# Bot config
BOT_PREFIX=.first
CHECK_PREFIX=.cek

# Frontrun API
FRONTRUN_BASE_URL=https://loadbalance.frontrun.pro
FRONTRUN_SESSION_TOKEN=
FRONTRUN_CLIENT_VERSION=0.0.216
FRONTRUN_CLIENT_LANGUAGE=EN_US

# Deep crawl settings
DEEP_PAGE_SIZE=50
DEEP_MAX_PAGES=200
DEEP_DELAY_MS=1500
PROGRESS_UPDATE_MS=15000

# Cooldown (ms)
FIRST_COOLDOWN_MS=90000

# Timezone
TIMEZONE=Asia/Jakarta

# Logging
LOG_LEVEL=info
